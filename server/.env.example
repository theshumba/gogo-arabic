# Database
MONGODB_URI=mongodb://localhost:27017/gogo-arabic

# Server
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
# Global rate limit (requests per 15 minutes per IP)
RATE_LIMIT_GLOBAL=100

# Auth rate limit (login/register attempts per 15 minutes per IP)
RATE_LIMIT_AUTH=5

# API rate limit (requests per minute per user/IP)
RATE_LIMIT_API=60

# Shop rate limit (purchase attempts per minute per user/IP)
RATE_LIMIT_SHOP=10

# Logging
# Available levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Production Settings (for deployment)
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gogo-arabic

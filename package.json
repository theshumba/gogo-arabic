{
  "name": "gogo-arabic",
  "version": "0.1.0",
  "description": "Arabic learning RPG built with React, Phaser 3, and Redux Toolkit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "server": "node server/src/server.js",
    "server:dev": "cd server && npm run dev",
    "seed": "node scripts/seed-db.js",
    "build:alphabet": "node scripts/build-alphabet.js",
    "build:vocabulary": "node scripts/build-vocabulary.js",
    "ink:compile": "node scripts/compile-ink.mjs",
    "vocab:validate": "node scripts/validate-vocab.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:world-terminology": "node scripts/lint-world-terminology.js",
    "report:kenmi-coverage": "node scripts/report-kenmi-coverage.js",
    "generate:kenmi-frame-tables": "node scripts/generate-kenmi-frame-tables.js",
    "capture:world-snapshots": "node scripts/capture-world-snapshots.js",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"server/**/*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\" \"server/**/*.{js,json}\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "framer-motion": "^11.15.0",
    "howler": "^2.2.4",
    "inkjs": "^2.4.0",
    "js-arabic-reshaper": "^1.0.0",
    "phaser": "^3.90.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.8.0",
    "redux-persist": "^6.0.0",
    "ts-fsrs": "^5.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^7.3.1",
    "vitest": "^3.0.0"
  }
}

# Gogo Arabic — environment variable template.
# Copy to .env.local and fill in real values. .env.local is gitignored (.gitignore line 4).

# --- PostHog product analytics (Phase 102 — OBS-01..OBS-04) ---
# Project API Key from PostHog Project Settings.
# Setup: PostHog dashboard -> create "Gogo Arabic" project inside FrameCoach org (EU region) ->
#        Project Settings -> Authorized URLs -> add http://localhost:3000 ->
#        copy Project API Key (starts with phc_...) here.
# Leave blank to disable telemetry entirely — initPostHog() is a graceful no-op when this is empty.
# NEVER commit a real key (this file is the template; .env.local holds the secret).
VITE_POSTHOG_KEY=

# PostHog ingest host. EU region default for UK-based primary user / EU data-residency.
# Override only if the project is migrated to a different region.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

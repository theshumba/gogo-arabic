{"inkVersion":21,"root":[[{"->":"check_vocab"},["done",{"#n":"g-0"}],null],"done",{"check_vocab":["ev","str","^big_1","/str",{"x()":"getVocabMastery","exArgs":1},"/ev",{"VAR=":"knows_big","re":true},"\n","ev","str","^old_1","/str",{"x()":"getVocabMastery","exArgs":1},"/ev",{"VAR=":"knows_old","re":true},"\n","ev","str","^brave_1","/str",{"x()":"getVocabMastery","exArgs":1},"/ev",{"VAR=":"knows_brave","re":true},"\n","ev","str","^tall_1","/str",{"x()":"getVocabMastery","exArgs":1},"/ev",{"VAR=":"knows_tall","re":true},"\n","ev",{"VAR?":"knows_big"},{"VAR?":"knows_old"},"+",{"VAR?":"knows_brave"},"+",{"VAR?":"knows_tall"},"+","/ev",{"VAR=":"comprehension_score","re":true},"ev",{"VAR?":"comprehension_score"},3,">=","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"tier_full"},{"->":".^.^.^.48"},null]}],"nop","\n","ev",{"VAR?":"comprehension_score"},1,">=",{"VAR?":"comprehension_score"},3,"<","&&","/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"tier_partial"},{"->":".^.^.^.60"},null]}],"nop","\n",{"->":"tier_none"},null],"tier_full":[["^(The palace inscription reads clearly — you understand the philosophy of just rule.)","\n","ev","str","^\"Ruling with justice is the balance of the kingdom.\"","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^\"The ruler is the servant of the people, not their master.\"","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Al-hukm — ruling. Al-adl — justice. Al-mizan — the balance/scales.","\n","^From the root ح-ك-م: hakama — to rule, hakim — ruler, hakim — wise one.","\n","ev","str","^big_1","/str","str","^inscription_palace_review","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","ev","str","^brave_1","/str","str","^inscription_palace_review","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","end",{"#f":5}],"c-1":["\n","^Al-hakim khadim — the ruler is a servant. A foundational principle of just governance.","\n","ev","str","^old_1","/str","str","^inscription_palace_review","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","ev","str","^tall_1","/str","str","^inscription_palace_review","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","end",{"#f":5}]}],null],"tier_partial":[["^(You can parse the weight of this text — al-hakim... al-adl... a royal decree of some kind.)","\n","ev","str","^I recognise \"justice\" — al-adl.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^I see \"ruler\" — al-hakim.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^Al-adl — justice. Root ع-د-ل: to be just, just one, justice system.","\n","ev","str","^brave_1","/str","str","^inscription_palace_partial","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","ev","str","^old_1","/str","str","^inscription_palace_partial","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","end",{"#f":5}],"c-1":["\n","^Al-hakim from root ح-ك-م — same root as hakim (wise) and hikma (wisdom).","\n","ev","str","^big_1","/str","str","^inscription_palace_partial","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","ev","str","^tall_1","/str","str","^inscription_palace_partial","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","end",{"#f":5}]}],null],"tier_none":[["^(This inscription is inlaid with gold above the throne — it carries the full weight of royal authority.)","\n","ev","str","^What does this royal inscription say?","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^These words are beyond me for now.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","^\"Ruling with justice is the balance of the kingdom. The ruler is the servant of the people, not their master.\"","\n","^The root ح-ك-م gives hukm — rule, hakim — ruler, and hikma — wisdom.","\n","ev","str","^big_1","/str","str","^inscription_palace_intro","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","ev","str","^brave_1","/str","str","^inscription_palace_intro","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","end",{"#f":5}],"c-1":["\n","^Humility is a virtue. Return when you are ready.","\n","ev","str","^old_1","/str","str","^inscription_palace_intro","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","ev","str","^tall_1","/str","str","^inscription_palace_intro","/str",{"x()":"addFsrsCardFromInk","exArgs":2},"pop","/ev","\n","end",{"#f":5}]}],null],"global decl":["ev",0,{"VAR=":"knows_big"},0,{"VAR=":"knows_old"},0,{"VAR=":"knows_brave"},0,{"VAR=":"knows_tall"},0,{"VAR=":"comprehension_score"},"/ev","end",null]}],"listDefs":{}}
            "transliteration": "ana 'umar, azra'u haadhihi al-ard mundhu siniin"
          },
          {
            "speaker": "npc",
            "arabic": "لِنَتَحَدَّث عَن الطَّبيعَة!",
            "english": "Let's talk about nature!",
            "transliteration": "linatahaddath 'an at-tabii'a!"
          },
          {
            "speaker": "player",
            "choices": [
              {
                "arabic": "أَخبِرني عَن الطَّبيعَة",
                "english": "Tell me about nature",
                "next": "teach_nature"
              },
              {
                "arabic": "شُكراً يا عُمَر",
                "english": "Thank you, Omar",
                "action": "end"
              }
            ]
          }
        ]
      },
